# --- Database (Postgres) ---
# App runtime uses the pooled URL; Prisma migrations use the direct one.
# Local dev: a local Postgres, e.g. postgresql://unswap:unswap@localhost:5432/unswap
# Production: set these in your host's env (e.g. Vercel), pointing at Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/unswap?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/unswap?schema=public"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32  (or: npx auth secret)
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL used in emails / callbacks.
AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
# Optional locally: without a key, emails are logged to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="UnSwap <onboarding@resend.dev>"

# --- Waitlist confirmation email (Kit / ConvertKit) ---
# Powers the double opt-in: the join form tags the subscriber, which triggers a
# Kit automation that emails the confirm link. The automation's link must point
# at this app: .../api/waitlist/confirm?token={{waitlist_token}}
# Without these, the waitlist still works in dev — the confirm link is returned
# to the browser directly instead of emailed.
KIT_API_KEY=""      # Kit v4 API key (X-Kit-Api-Key)
KIT_TAG_ID=""       # Tag that triggers the confirmation-email automation
KIT_FORM_ID=""      # Form/list confirmed subscribers are added to

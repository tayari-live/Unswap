# --- Database (Postgres) ---
# App runtime uses the pooled URL; Prisma migrations use the direct one.
# Local dev: a local Postgres, e.g. postgresql://unswap:unswap@localhost:5432/unswap
# Production: set these in your host's env (e.g. Vercel), pointing at Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/unswap?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/unswap?schema=public"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32  (or: npx auth secret)
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL used in emails / callbacks.
AUTH_URL="http://localhost:3000"

# --- Email (Mailtrap) ---
# Optional locally: without a token, emails are logged to the console instead.
# Transactional email (Mailtrap "Email Sending" — NOT the Testing sandbox,
# which captures messages and never delivers them).
MAILTRAP_TOKEN=""
# Must be on a domain verified in Mailtrap, or sending is rejected.
EMAIL_FROM="UnSwap <hello@mail.unswap.net>"

# --- Marketing list (Kit / ConvertKit) ---
# Marketing only. The waitlist confirmation is sent through Mailtrap above.
# Subscribers are added to Kit at waitlist signup and tagged at each funnel
# milestone. Entirely optional — without KIT_API_KEY every Kit call is a no-op
# and the waitlist works exactly the same, minus the marketing sync. Each
# KIT_TAG_* is the numeric tag id from Kit (unset = that tag is skipped). The
# custom fields organisation, referred_by and referrals_count must exist in Kit.
KIT_API_KEY=""                # Kit v4 API key (X-Kit-Api-Key)
KIT_TAG_UNSWAP=""             # Blanket source tag (every UnSwap subscriber)
KIT_TAG_JOINED=""             # Joined the waitlist (may be unconfirmed)
KIT_TAG_CONFIRMED=""          # Clicked the confirm link
KIT_TAG_ACCOUNT_CREATED=""    # Created an account
KIT_TAG_HOME_LISTED=""        # Listed their first home
KIT_TAG_SUBSCRIBED=""         # Started a paid membership
KIT_TAG_REFERRER=""           # Has at least one verified referral

# --- Waitlist referral engine (Waitlister / waitlister.me) ---
# Mirrors each waitlist signup onto the hosted list and owns the referral loop
# (position, referral code, leaderboard). The share page prefers Waitlister's
# live figures and falls back to the app's own DB. Optional — without these the
# waitlist works the same, using the app's own positions/codes. Both required.
WAITLISTER_API_KEY=""          # Waitlister API key (X-Api-Key)
WAITLISTER_WAITLIST_KEY=""     # Which Waitlister list to target (URL path)

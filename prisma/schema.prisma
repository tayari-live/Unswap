// UnSwap — Prisma schema (PostgreSQL).
// Learn more: https://pris.ly/d/prisma-schema
//
// DATABASE_URL  — pooled connection used at runtime (Neon "-pooler" host).
// DIRECT_URL    — direct, unpooled connection used by `prisma migrate`.
// On Neon both come from the dashboard; DIRECT_URL drops the "-pooler" suffix.
// Falls back to DATABASE_URL if DIRECT_URL is unset (e.g. local Docker Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A platform user. Covers both verified/applicant members and admins.
// `role` is "member" or "admin". Statuses are stored as strings (no enums)
// so the schema stays portable across SQLite and Postgres.
model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  // Nullable: members arriving from the waitlist invite are created without a
  // password (email already verified by the invite click) and set one only after
  // onboarding + adding a property. Null => passwordless, still completing setup.
  passwordHash       String?
  firstName          String
  lastName           String
  fullName           String
  role               String    // "member" | "admin"
  avatarInitials     String
  imageUrl           String?

  // Member profile
  organisation       String?   // e.g. "UNDP", "World Bank Group"
  nationality        String?
  dutyStation        String?   // current posting city
  languages          String?   // comma-separated languages spoken
  bio                String?
  linkedinUrl        String?
  profileCompletion  Int       @default(0) // percentage 0-100
  onboardedAt        DateTime? // set when the member finishes the onboarding wizard

  // Verification: PENDING_EMAIL | EMAIL_VERIFIED | PENDING_ID_REVIEW |
  //               FULLY_VERIFIED | REJECTED | SUSPENDED
  verificationStatus String    @default("PENDING_EMAIL")
  // Optional second, institutional email a member adds to prove affiliation when
  // they signed up with a non-recognised address. Confirming it runs the same
  // allowlist logic as the primary email (auto-verify / fast-track). Unique so a
  // work address can back at most one account.
  workEmail          String?   @unique
  workEmailVerifiedAt DateTime?
  // The member's own referral code and the code that referred them, captured at
  // registration from their waitlist entry. Lets trust-scoring resolve the
  // referrer as a durable User<->User link instead of re-deriving it by email.
  referralCode       String?   @unique
  referredByCode     String?
  trustScore         Float?    // weighted average of host reviews
  stripeCustomerId   String?   @unique // Stripe customer for billing

  // Email notification preferences (opt-out per category; transactional emails
  // such as verification, password reset, and billing are always sent).
  // Bell badge: activity items newer than this count as unread. Set when the
  // member opens their notifications page.
  notificationsSeenAt DateTime?

  // Last time the member saw the points celebration. Kept separate from
  // notificationsSeenAt so opening the bell never swallows the celebration.
  // Column name kept as "creditsCelebratedAt" (via @map) to avoid a rename.
  pointsCelebratedAt DateTime? @map("creditsCelebratedAt")

  // Set once the member has been shown the "you are verified" moment. Separate
  // from pointsCelebratedAt so the two never swallow one another.
  verifiedCelebratedAt DateTime?

  // Presence: bumped on activity; recent value => "online" in chat.
  lastSeenAt         DateTime?

  notifySwaps        Boolean   @default(true)
  notifyMessages     Boolean   @default(true)
  notifyReviews      Boolean   @default(true)
  notifyReminders    Boolean   @default(true)
  notifyMarketing    Boolean   @default(true)

  createdAt          DateTime  @default(now())

  // Relations
  submissions        VerificationSubmission[] @relation("SubmissionMember")
  reviewed           VerificationSubmission[] @relation("SubmissionReviewer")
  listings           Listing[]
  sentRequests       SwapRequest[]            @relation("Requester")
  hostedRequests     SwapRequest[]            @relation("Host")
  subscription       Subscription?
  auditLogs          AuditLog[]               @relation("ActorRelation")
  resetTokens        PasswordResetToken[]
  emailTokens        EmailVerificationToken[]
  workEmailTokens    WorkEmailToken[]
  conciergeLeads     ConciergeLead[]          @relation("ConciergeMember")
  guarantorRequests  GuarantorRequest[]       @relation("GuarantorMember")
  loginTokens        LoginToken[]
  favourites         Favourite[]
  conversations      ConversationParticipant[]
  messages           Message[]
  reviewsWritten     Review[]                 @relation("ReviewAuthor")
  reviewsReceived    Review[]                 @relation("ReviewSubject")
  reportsMade        Report[]                 @relation("ReportReporter")
  pointTransactions  PointTransaction[]       @relation("PointUser")

  @@index([verificationStatus])
  @@index([role])
}

// Single-use, short-lived token that signs a member in without a password —
// used to drop a passwordless waitlist member straight into onboarding, and to
// send a "resume setup / sign-in link" to anyone who hasn't set a password yet.
model LoginToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A member-submitted report on a message or review, for admin moderation.
// Target is polymorphic (no FK) so one queue covers multiple content types.
model Report {
  id           String    @id @default(uuid())
  reporterId   String
  targetType   String    // "message" | "review"
  targetId     String
  reason       String?
  status       String    @default("open") // open | dismissed | actioned
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// A private thread between verified members, optionally tied to a swap request.
model Conversation {
  id            String   @id @default(uuid())
  swapRequestId String?  @unique // optional 1:1 link to a swap for context
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants  ConversationParticipant[]
  messages      Message[]
  swapRequest   SwapRequest? @relation(fields: [swapRequestId], references: [id], onDelete: SetNull)

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  typingAt       DateTime? // last typing ping — "typing…" shows while this is recent

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                 String   @id @default(uuid())
  conversationId     String
  senderId           String
  body               String
  attachmentUrl      String?  // inline base64 image data URL
  createdAt          DateTime @default(now())
  deletedForEveryone Boolean  @default(false) // tombstone: content cleared, shows "deleted"
  hiddenFor          String[] @default([])    // user ids who deleted it just for themselves

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A member's private saved/favourite listing.
model Favourite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

// One-time token emailed to a new member to confirm their institutional address.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A Relocation Concierge request. Triaged on submission (category/priority/
// summary drafted by the AI agent, with a static fallback) and routed to the
// team. Only trust-eligible members can create one.
model ConciergeLead {
  id          String   @id @default(uuid())
  memberId    String
  destination String
  timeframe   String?
  needs       String   // the member's description of what they need
  category    String   // AI-assigned: Housing | Schools & Family | Logistics | Local Setup | General
  priority    String   // AI-assigned: high | medium | low
  summary     String   // one-line triage summary
  nextSteps   String?  // suggested next steps
  status      String   @default("new") // new | in_progress | closed
  trustScore  Int      // snapshot at request time
  createdAt   DateTime @default(now())

  member      User     @relation("ConciergeMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// A guarantor invitation: a member who can't verify via their own institutional
// email names a UN/IO contact, who confirms (by receiving the emailed link) and
// explicitly approves — vouching for the member's professional standing.
model GuarantorRequest {
  id             String    @id @default(uuid())
  memberId       String
  guarantorEmail String    // the invited contact's institutional address
  guarantorName  String?
  token          String    @unique
  status         String    @default("pending") // pending | approved | declined
  respondedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  member         User      @relation("GuarantorMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Confirms a secondary, institutional email a member adds to prove affiliation.
// Unlike EmailVerificationToken (which confirms the account's own email) this
// carries the target address, since it is not the account's login email.
model WorkEmailToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  email     String    // the institutional address being confirmed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin-editable allowlist of approved institutional email domains.
// `fastTrack` domains skip manual review and go straight to email verification.
model AllowedDomain {
  id        String   @id @default(uuid())
  domain    String   @unique // e.g. "un.org"
  label     String   // human-readable org name, e.g. "United Nations"
  fastTrack Boolean  @default(true)
  // When true, confirming an institutional email on this domain IS the proof of
  // affiliation: the member skips the document upload + officer review and
  // becomes FULLY_VERIFIED the moment they click the confirmation link. Kept
  // separate from fastTrack (which only lightens the document/review burden) so
  // "no human at all" is an explicit, deliberate choice per domain.
  autoVerify Boolean @default(false)
  createdAt DateTime @default(now())
}

// A document submission entering the admin verification queue.
model VerificationSubmission {
  id           String    @id @default(uuid())
  memberId     String
  type         String    // "fast_track" | "manual"
  idCardUrl    String?
  proofUrl     String?   // proof of employment (manual review only)
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?
  reviewerId   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  member       User      @relation("SubmissionMember", fields: [memberId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// A member's active subscription tier.
model Subscription {
  id                String   @id @default(uuid())
  userId            String   @unique
  tier              String   // limited_1x | standard_2x | professional_4x | unlimited_pro | lifetime
  status            String   @default("active") // active | past_due | cancelled
  exchangesPerYear  Int      // -1 for unlimited
  priceAnnual       Int      // in whole currency units (annual; one-time for lifetime)
  propertyGuarantee Int      // guarantee amount
  renewsAt          DateTime?
  renewalReminderSentAt DateTime? // set when the 7-day renewal reminder is sent
  stripeSubscriptionId String? @unique // Stripe subscription (null for lifetime/dev)
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A home listing.
model Listing {
  id              String   @id @default(uuid())
  ownerId         String
  title           String
  propertyType    String   // Apartment | House | Villa | Studio | Townhouse
  city            String
  country         String
  neighbourhood   String?
  bedrooms        Int      @default(1)
  bathrooms       Int      @default(1)
  maxGuests       Int      @default(2)
  description     String?
  primaryPhotoUrl String?  // mirrors the first gallery photo, for card rendering
  exchangeType    String   @default("either") // simultaneous | points | either
  nightlyPoints   Int      @default(100)      // auto-assigned value per night (100-300), amenity-weighted
  nightlyAdjustment Int    @default(0)        // host's manual nudge, -30..30
  status          String   @default("DRAFT")  // DRAFT | ACTIVE | PAUSED | ARCHIVED
  flagged         Boolean  @default(false)
  autoPaused      Boolean  @default(false) // paused by the system on subscription lapse
  rating          Float?
  createdAt       DateTime @default(now())

  // Richer property details
  wifiSpeed       String?  // under_50 | 50_200 | 200_plus | gigabit
  amenities       String?  // comma-separated amenity keys
  swapDurations   String?  // comma-separated: short_term,medium_term,long_term,extended
  houseRules      String?

  // Private, encrypted-at-rest. Only revealed to a confirmed swap partner.
  fullAddressEnc       String?
  emergencyNameEnc     String?
  emergencyPhoneEnc    String?
  emergencyRelationEnc String?

  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  swapRequests    SwapRequest[]
  favourites      Favourite[]
  reviews         Review[]
  photos          ListingPhoto[]
  blackouts       BlackoutDate[]
  availability    AvailabilityWindow[]

  @@index([status])
  @@index([city])
}

// A points ledger entry. Host earns on a completed points swap; requester
// spends. Earned points are PENDING on confirmation, CONFIRMED on completion.
// The physical table stays "CreditTransaction" (via @@map) so this rename needs
// no table migration — only the code moves from "credits" to "points".
model PointTransaction {
  id        String   @id @default(uuid())
  userId    String
  swapId    String?
  type      String   // earned | spent
  amount    Int      // whole points (positive)
  status    String   @default("confirmed") // pending | confirmed
  reason    String?  // free-points grant source: welcome | first_listing | verified | first_subscription (null for swap txns)
  createdAt DateTime @default(now())

  user      User     @relation("PointUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  // One free-points grant per member per reason, enforced by the database.
  // The service checked before inserting, but two concurrent calls could both
  // pass that check. Swap transactions carry reason = NULL, and Postgres treats
  // NULLs as distinct, so they are unaffected by this constraint.
  @@unique([userId, reason])
  @@map("CreditTransaction")
}

// A gallery photo for a listing. position 0 is the primary card image.
model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  url       String   // base64 data URL (the app's inline-image pattern)
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// An unavailable date range on a listing's calendar.
model BlackoutDate {
  id        String   @id @default(uuid())
  listingId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Positive availability: date ranges the home is open for a swap (the Vacation
// Swap Calendar). A listing with none is treated as open year-round (subject to
// blackouts); a listing with windows is available only within them, and drives
// the "Available Now" tag and vacation-window matching.
model AvailabilityWindow {
  id        String   @id @default(uuid())
  listingId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// A swap request between two members for a listing.
model SwapRequest {
  id          String   @id @default(uuid())
  requesterId String
  hostId      String
  listingId   String
  mode        String   // simultaneous | points
  pointsPerNight Int?  // snapshot of the home's nightly value when the request was made (points swaps)
  startDate   DateTime
  endDate     DateTime
  guests      Int      @default(1)
  // REQUESTED | COUNTER_OFFERED | ACCEPTED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  status      String   @default("REQUESTED")
  disputed    Boolean  @default(false)
  message     String?
  createdAt   DateTime @default(now())
  completedAt DateTime? // set when the exchange is marked COMPLETED (review window start)
  reminderSentAt DateTime? // set when the 48h "exchange starts soon" reminder is sent
  consumesSlot Boolean  @default(true) // counts against requester's annual exchange limit
  counteredAt DateTime? // when the host last counter-offered (drives 7-day expiry)
  // AI-drafted agreement clauses (JSON array of {heading, text}), generated once
  // on first agreement download and reused so the document stays stable.
  agreementClauses String? // @db.Text via TEXT column in migration

  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  host        User     @relation("Host", fields: [hostId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviews     Review[]
  conversation Conversation?

  @@index([status, createdAt])
}

// Pre-launch waitlist signups with referral tracking.
model WaitlistEntry {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  organisation String?
  referralCode String    @unique
  referredBy   String?   // referralCode of the referrer
  referrals    Int       @default(0)
  status       String    @default("pending") // pending | invited | converted
  // Double opt-in: an entry only counts once the emailed link is clicked.
  confirmToken String?   @unique
  confirmedAt  DateTime? // null = email not yet confirmed (not on the list yet)
  // Single-use grant minted when the emailed link is confirmed: proof the person
  // owns this address, handed to /register so the account is created already
  // email-verified. Consumed (nulled) on first use so it can never be replayed.
  registerGrant        String?   @unique
  registerGrantExpires DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([confirmedAt, referrals])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String   // e.g. "MEMBER_VERIFIED", "DOMAIN_ADDED"
  subject   String   // human-readable description
  metadata  String?
  createdAt DateTime @default(now())

  actor     User?    @relation("ActorRelation", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// In-app notifications shown to admins via the header bell.
model Notification {
  id        String   @id @default(uuid())
  type      String   // "verification" | "dispute" | "system" | ...
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// A post-exchange review. Each party reviews the other once per completed swap.
// `aboutHost` marks reviews of the host (these feed the host's trust score and
// the listing rating). Sub-ratings apply to host reviews; guest reviews use
// `overall` + `communication` only.
model Review {
  id                  String   @id @default(uuid())
  swapId              String
  authorId            String   // who wrote the review
  subjectId           String   // who the review is about
  listingId           String?  // set on host reviews (the home stayed in)
  aboutHost           Boolean  // true when the subject was the swap's host
  overall             Int      // 1-5
  communication       Int      // 1-5
  propertyAccuracy    Int?     // host reviews only
  cleanliness         Int?     // host reviews only
  neighbourhoodSafety Int?     // host reviews only
  body                String
  createdAt           DateTime @default(now())

  swap     SwapRequest @relation(fields: [swapId], references: [id], onDelete: Cascade)
  author   User        @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject  User        @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  listing  Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([swapId, authorId])
  @@index([subjectId])
  @@index([listingId])
}

/// Fixed-window rate limiting for the public endpoints that send email.
/// Kept in Postgres rather than an external store so there is no extra service
/// to run: these routes already query the database, and a rejected request
/// costs one indexed lookup instead of a lookup plus an email.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
